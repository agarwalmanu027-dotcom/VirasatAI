# Keep the source repository focused on this project.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/VirasatAI_Project_Context.txt
!/VirasatAI_Content_Library_Guide.md
!/VirasatAI_Places_Folder_Guide.md
!/01_Data/
!/02_Images/
!/03_Scripts/
!/04_Audio/
!/06_Database/
!/frontend_recovered/
!/backend/
!/tools/
!/output/
!/VirasatAI_Final_Project_Report_Revised_v10.docx

# Generated files, local settings, authentication and live databases.
**/.git/
**/.dart_tool/
**/.gradle/
**/.kotlin/
**/.idea/
**/node_modules/
**/.wrangler/
**/build/
**/coverage/
**/__pycache__/
**/*.pyc
**/*.log
**/*.iml
**/.env
**/.env.*
!**/.env.example
**/.dev.vars
**/.dev.vars.*
**/local.properties
**/key.properties
**/*.jks
**/*.keystore
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.sqlite
**/*.sqlite-*
**/*.db
**/*.db-*
**/.flutter-plugins-dependencies
**/.DS_Store
**/Thumbs.db
/backend/data/
/backend/cloudflare/wrangler.toml

# Original photo collections stay local; the ready-to-run app images are
# versioned in frontend_recovered/assets/images with their provenance records.
/02_Images/**/*.jpg
/02_Images/**/*.jpeg
/02_Images/**/*.png
/02_Images/**/*.webp
/02_Images/**/*.gif
/tools/image_review/**/*.jpg
/tools/image_review/**/*.jpeg
/tools/image_review/**/*.png
/tools/image_review/**/*.webp
/tools/image_review/**/*.gif

# Build outputs are distributed separately; keep final presentation and guide.
/output/apk/
**/*.apk
**/*.aab
**/*.zip
**/*.7z
**/*.tar
**/*.gz
**/*.mp4
**/*.mkv
**/*.tmp
**/~$*
