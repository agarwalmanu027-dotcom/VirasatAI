    {
      "title": "File:Meenakshi Temple, Shiva, Hanuman, Ekapada-Trimurti, Madurai, India.jpg",
      "source_page": "https://commons.wikimedia.org/wiki/File:Meenakshi_Temple,_Shiva,_Hanuman,_Ekapada-Trimurti,_Madurai,_India.jpg",
      "original_url": "https://upload.wikimedia.org/wikipedia/commons/6/66/Meenakshi_Temple%2C_Shiva%2C_Hanuman%2C_Ekapada-Trimurti%2C_Madurai%2C_India.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
      "preview_url": "https://thumb.wikimedia.org/wikipedia/commons/thumb/6/66/Meenakshi_Temple%2C_Shiva%2C_Hanuman%2C_Ekapada-Trimurti%2C_Madurai%2C_India.jpg/1280px-Meenakshi_Temple%2C_Shiva%2C_Hanuman%2C_Ekapada-Trimurti%2C_Madurai%2C_India.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail",
